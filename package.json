{
  "name": "kentofon",
  "version": "1.0.0",
  "description": "Кентофон — звонилка по ID",
  "main": "server.js",
  "scripts": {
    "start": "node dist/kentofon.js",
    "dev": "node server.js",
    "build": "esbuild server.js --bundle --platform=node --target=node18 --outfile=dist/kentofon.js --external:bufferutil --external:utf-8-validate --external:uWebSockets.js --legal-comments=none && cp node_modules/socket.io/client-dist/socket.io.min.js public/vendor/"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3",
    "socket.io": "^4.8.4"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
